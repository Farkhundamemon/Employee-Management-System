@model List<EmployeeManagementSystem.Models.Leave>

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; align-items:center; gap:10px;">
            <div style="width:34px; height:34px; border-radius:9px; background:#F1EAFB; display:flex; align-items:center; justify-content:center; font-size:16px;">🗓️</div>
            <strong>Leave Requests</strong>
        </div>
        <span style="color:var(--text-soft); font-size:12px;">Submitted by employees via their portal</span>
    </div>

    @if (Model.Count == 0)
    {
        <div style="padding:30px; color:var(--text-soft); text-align:center;">No leave requests yet.</div>
    }
    else
    {
        <table>
            <tr>
                <th>Employee ID</th>
                <th>Type</th>
                <th>Start</th>
                <th>End</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Approved/Rejected By</th>
                <th>Action</th>
            </tr>
            @foreach (var leave in Model)
            {
                <tr>
                    <td>@leave.emp_id</td>
                    <td>@leave.leave_type</td>
                    <td>@leave.start_date.ToString("dd-MM-yyyy")</td>
                    <td>@leave.end_date.ToString("dd-MM-yyyy")</td>
                    <td>@leave.reason</td>
                    <td>
                        @{
                            var badgeColor = leave.status == "Approved" ? "#E4F5EC" : leave.status == "Rejected" ? "#FDECEA" : "#FDF3E0";
                            var textColor = leave.status == "Approved" ? "#2E9E6B" : leave.status == "Rejected" ? "#D2483A" : "#D9A125";
                        }
                        <span style="background:@badgeColor; color:@textColor; padding:4px 12px; border-radius:20px; font-size:11.5px; font-weight:600;">@leave.status</span>
                    </td>
                    <td>
                        @if (leave.approved_by != null)
                        {
                            <div style="font-size:11.5px; color:var(--text-soft);">
                                @leave.approved_by<br>
                                @leave.approved_date?.ToString("dd-MM-yyyy hh:mm tt")
                            </div>
                        }
                        else
                        {
                            <span style="color:var(--text-soft); font-size:11.5px;">—</span>
                        }
                    </td>
                    <td>
                        @if (leave.status == "Pending")
                        {
                            <a href="/Leave/Approve/@leave.leave_id" class="icon-btn" style="color:#2E9E6B; font-weight:600;">Approve</a>
                            <a href="/Leave/Reject/@leave.leave_id" class="icon-btn" style="color:#D9A125; font-weight:600;">Reject</a>
                        }
                        <a href="/Leave/Delete/@leave.leave_id" class="icon-btn" style="color:#D2483A;" onclick="return confirm('Are you sure you want to delete this record?');">Delete</a>
                    </td>
                </tr>
            }
        </table>
    }
</div>