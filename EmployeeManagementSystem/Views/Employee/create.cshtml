@model EmployeeManagementSystem.Models.Employee

<h2>Add New Employee</h2>

<form method="post" action="/Employee/Create">

    <label>Full Name:</label><br />
    <input type="text" name="emp_name" required /><br /><br />

    <label>Email:</label><br />
    <input type="email" name="emp_email" required /><br /><br />

    <label>Phone:</label><br />
    <input type="text" name="phone" /><br /><br />

    <label>Department ID:</label><br />
    <input type="number" name="Dep_id" required /><br /><br />

    <label>Designation:</label><br />
    <input type="text" name="designation" /><br /><br />

    <label>Joining Date:</label><br />
    <input type="date" name="joiningDate" /><br /><br />

    <label>Salary:</label><br />
    <input type="number" step="0.01" name="salary" /><br /><br />

    <label>Password:</label><br />
    <input type="password" name="password" /><br /><br />

    <button type="submit">Add Employee</button>

</form>

