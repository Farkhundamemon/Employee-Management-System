@model EmployeeManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Add Loan";
}

<div style="max-width:500px; margin:0 auto;">
    <a href="/Loan/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Loans</a>

    <div class="panel">
        <form method="post" action="/Loan/Create">
            <div class="field">
                <label>Employee ID</label>
                <input type="number" name="emp_id" required />
            </div>
            <div class="field">
                <label>Loan Amount</label>
                <input type="number" step="0.01" name="loan_amount" required />
            </div>
            <div class="field">
                <label>Monthly Installment</label>
                <input type="number" step="0.01" name="monthly_installment" required />
            </div>
            <div class="field">
                <label>Start Date</label>
                <input type="date" name="start_date" required />
            </div>
            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn">Add Loan</button>
                <a href="/Loan/Index" class="btn outline">Cancel</a>
            </div>
        </form>
    </div>
</div>