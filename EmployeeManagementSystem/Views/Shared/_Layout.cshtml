<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management System</title>
    <style>
            :root {
                --navy: #1F2937;
                --navy-dark: #16202C;
                --accent: #E86A2C;
                --accent-soft: #FCE8DD;
                --bg: #F5F6F8;
                --card: #FFFFFF;
                --text: #26303B;
                --text-soft: #6B7684;
                --border: #E7E9EC;
                --green: #2E9E6B;
                --amber: #D9A125;
                --red: #D2483A;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                background: var(--bg);
                color: var(--text);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 230px;
                background: var(--navy-dark);
                color: #fff;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
            }

                .sidebar .brand {
                    padding: 22px 20px;
                    font-size: 18px;
                    font-weight: 700;
                    border-bottom: 1px solid rgba(255,255,255,0.08);
                }

                    .sidebar .brand span {
                        color: var(--accent);
                    }

            .nav {
                margin-top: 10px;
                flex: 1;
            }

                .nav a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 12px 20px;
                    color: #B7C0CC;
                    text-decoration: none;
                    font-size: 14px;
                    border-left: 3px solid transparent;
                }

                    .nav a:hover {
                        background: rgba(255,255,255,0.04);
                        color: #fff;
                    }

                    .nav a.active {
                        background: rgba(232,106,44,0.12);
                        border-left: 3px solid var(--accent);
                        color: #fff;
                        font-weight: 600;
                    }

                .nav .dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: currentColor;
                    opacity: 0.6;
                }

            .user-chip {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 14px 20px 10px;
                border-top: 1px solid rgba(255,255,255,0.08);
                margin-top: 10px;
            }

            .user-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: var(--accent);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 12px;
                flex-shrink: 0;
            }

            .user-info {
                font-size: 12px;
                color: #B7C0CC;
                line-height: 1.4;
            }

                .user-info strong {
                    color: #fff;
                    display: block;
                    font-size: 13px;
                }

            .logout-link {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 20px;
                color: #E8A9A0;
                text-decoration: none;
                font-size: 13.5px;
                font-weight: 600;
                border-top: 1px solid rgba(255,255,255,0.08);
                margin-top: 8px;
                transition: background .15s;
            }

                .logout-link:hover {
                    background: rgba(210,72,58,0.15);
                    color: #fff;
                }

                .logout-link .ic {
                    flex-shrink: 0;
                }

            .main {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .topbar {
                background: var(--card);
                padding: 14px 28px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid var(--border);
            }

                .topbar h1 {
                    font-size: 18px;
                    font-weight: 700;
                }

            .content {
                padding: 26px 28px;
            }

            .stats {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
                gap: 16px;
                margin-bottom: 24px;
            }

            .stat-card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 18px;
            }

                .stat-card .label {
                    font-size: 12px;
                    color: var(--text-soft);
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                }

                .stat-card .value {
                    font-size: 26px;
                    font-weight: 700;
                    margin-top: 6px;
                }

                .stat-card.accent .value {
                    color: var(--accent);
                }

            .panel {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 20px;
                margin-bottom: 20px;
            }

                .panel h2 {
                    font-size: 15px;
                    font-weight: 700;
                    margin-bottom: 14px;
                }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            th {
                text-align: left;
                color: var(--text-soft);
                font-weight: 600;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                padding: 10px 12px;
                border-bottom: 1px solid var(--border);
            }

            td {
                padding: 12px;
                border-bottom: 1px solid var(--border);
                vertical-align: middle;
            }

            tr:last-child td {
                border-bottom: none;
            }

            .badge {
                padding: 4px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
            }

                .badge.active {
                    background: #E4F5EC;
                    color: var(--green);
                }

                .badge.leave {
                    background: #FDF3E0;
                    color: var(--amber);
                }

                .badge.pending {
                    background: #FDECEA;
                    color: var(--red);
                }

            .btn {
                background: var(--accent);
                color: #fff;
                border: none;
                padding: 9px 16px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                display: inline-block;
            }

                .btn.outline {
                    background: transparent;
                    color: var(--text);
                    border: 1px solid var(--border);
                }

            .toolbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 16px;
            }

            .icon-btn {
                background: none;
                border: none;
                color: var(--text-soft);
                cursor: pointer;
                font-size: 13px;
                margin-right: 8px;
                text-decoration: none;
            }

            .field label {
                font-size: 12px;
                color: var(--text-soft);
                display: block;
                margin-bottom: 6px;
            }

            .field {
                margin-bottom: 14px;
                max-width: 420px;
            }

                .field input, .field select {
                    width: 100%;
                    padding: 9px 12px;
                    border: 1px solid var(--border);
                    border-radius: 6px;
                    font-size: 13px;
                }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="brand">Prim<span>Xact</span> HR</div>
        <div class="nav">
            <a href="/Home/Index"><span class="dot"></span> Dashboard</a>
            <a href="/Employee/Index"><span class="dot"></span> Employees</a>
            <a href="/Department/Index"><span class="dot"></span> Departments</a>
            <a href="/Attendance/Index"><span class="dot"></span> Attendance</a>
            <a href="/Leave/Index"><span class="dot"></span> Leave Management</a>
            <a href="/Payroll/Index"><span class="dot"></span> Payroll</a>
            <a href="/Report/Index"><span class="dot"></span> Reports</a>
        </div>

        <div class="user-chip">
            <div class="user-avatar">@(Context.Session.GetString("UserRole") == "Admin" ? "A" : "HR")</div>
            <div class="user-info">
                <strong>@(Context.Session.GetString("UserRole") ?? "Admin")</strong>
                Signed in
            </div>
        </div>
        <a href="/Account/Logout" class="logout-link">
            <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Logout
        </a>
    </div>

    <div class="main">
        <div class="topbar">
            <h1>@ViewData["Title"]</h1>
            <div style="display:flex; align-items:center; gap:8px; font-size:13.5px; color:var(--text);">
                <div style="width:32px; height:32px; border-radius:50%; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px;">
                    @(Context.Session.GetString("UserRole") == "Admin" ? "A" : "HR")
                </div>
                <span>@(Context.Session.GetString("UserRole") ?? "Admin") </span>
            </div>
        </div>
        <div class="content">
            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>