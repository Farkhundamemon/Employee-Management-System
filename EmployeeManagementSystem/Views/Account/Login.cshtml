@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Employee Management System</title>
    <style>
            body {
                margin: 0;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: radial-gradient(circle at 70% 60%, #E86A2C 0%, #7A3A1A 35%, #1A1210 75%, #0A0806 100%);
                font-family: 'Segoe UI', Arial, sans-serif;
            }

            .login-box {
                background: #fff;
                border-radius: 16px;
                padding: 40px 36px;
                width: 340px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            }

                .login-box h2 {
                    margin: 0 0 6px;
                    color: #1C2321;
                }

                .login-box p {
                    margin: 0 0 24px;
                    color: #6E7A72;
                    font-size: 13px;
                }

            .field {
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #6E7A72;
                    margin-bottom: 6px;
                }

                .field input {
                    width: 100%;
                    padding: 10px 13px;
                    border: 1px solid #E7E3D8;
                    border-radius: 9px;
                    font-size: 14px;
                    box-sizing: border-box;
                }

            .btn-login {
                width: 100%;
                padding: 11px;
                border: none;
                color: #fff;
                background: radial-gradient(circle at 70% 60%, #E86A2C 0%, #B84E20 60%, #7A3A1A 100%);
                border-radius: 9px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                margin-top: 8px;
            }

                .btn-login:hover {
                    opacity: 0.92;
                }

            .error-msg {
                background: #F6E7E4;
                color: #8C362F;
                padding: 10px 14px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 16px;
            }

            .hint {
                font-size: 11.5px;
                color: #9AA39C;
                margin-top: 18px;
                text-align: center;
            }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Welcome back</h2>
        <p>Sign in to Employee Management System</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/Login">
            <div class="field">
                <label>Username / Email</label>
                <input type="text" name="username" required />
            </div>
            <div class="field">
                <label>Password</label>
                <input type="password" name="password" required />
            </div>
            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <div class="hint">Admin: use your admin username · Employee: use your registered email</div>
    </div>

</body>
</html>