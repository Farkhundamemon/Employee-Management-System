@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Employee Management System</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                min-height: 100vh;
                display: flex;
            }

            .left-panel {
                flex: 1.15;
                background: linear-gradient(150deg, #0F1620 0%, #16202C 55%, #0F1620 100%);
                position: relative;
                overflow: hidden;
                padding: 56px 60px;
                color: #fff;
                display: flex;
                flex-direction: column;
            }

                .left-panel::before {
                    content: '';
                    position: absolute;
                    right: -140px;
                    top: -100px;
                    width: 420px;
                    height: 420px;
                    background: radial-gradient(circle, #E86A2C 0%, transparent 70%);
                    opacity: .28;
                }

            .brand-logo {
                position: relative;
                z-index: 2;
                font-size: 22px;
                font-weight: 800;
            }

                .brand-logo span {
                    color: #E86A2C;
                }

            .brand-sub {
                position: relative;
                z-index: 2;
                font-size: 13.5px;
                color: #9AA6B5;
                margin-top: 2px;
            }

            .left-content {
                position: relative;
                z-index: 2;
                margin-top: 50px;
                max-width: 460px;
            }

                .left-content h1 {
                    font-size: 34px;
                    font-weight: 800;
                    line-height: 1.2;
                }

                    .left-content h1 .accent {
                        color: #E86A2C;
                        display: block;
                    }

                .left-content p {
                    font-size: 14px;
                    color: #B7C0CC;
                    line-height: 1.65;
                    margin-top: 16px;
                }

            .feature-list {
                margin-top: 30px;
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .feature-item {
                display: flex;
                align-items: flex-start;
                gap: 14px;
            }

            .feature-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: rgba(232,106,44,0.14);
                color: #E86A2C;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .feature-item strong {
                font-size: 14px;
                display: block;
                margin-bottom: 2px;
            }

            .feature-item span {
                font-size: 12.5px;
                color: #9AA6B5;
            }

            .left-footer {
                position: relative;
                z-index: 2;
                margin-top: auto;
                padding-top: 24px;
                border-top: 1px solid rgba(255,255,255,0.08);
                font-size: 12px;
                color: #8A94A3;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .right-panel {
                flex: 0.95;
                background: #FAFBFC;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .login-box {
                width: 100%;
                max-width: 400px;
            }

                .login-box h2 {
                    font-size: 26px;
                    font-weight: 800;
                    color: #1A1F2B;
                    margin-bottom: 6px;
                }

                .login-box > p {
                    margin: 0 0 26px;
                    color: #6E7684;
                    font-size: 13.5px;
                }

            .field {
                margin-bottom: 16px;
            }

                .field label {
                    display: block;
                    font-size: 13px;
                    font-weight: 600;
                    color: #3A4250;
                    margin-bottom: 7px;
                }

            .input-wrap {
                position: relative;
            }

                .input-wrap .icon-left {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #9AA3B0;
                    display: flex;
                }

                .input-wrap input {
                    width: 100%;
                    padding: 12px 14px 12px 40px;
                    border: 1px solid #E3E7EC;
                    border-radius: 9px;
                    font-size: 14px;
                    background: #fff;
                    transition: .15s;
                }

                    .input-wrap input:focus {
                        outline: none;
                        border-color: #E86A2C;
                        box-shadow: 0 0 0 3px rgba(232,106,44,0.12);
                    }

            .toggle-eye {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: #9AA3B0;
                display: flex;
                padding: 2px;
            }

            .row-between {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin: 4px 0 20px;
                font-size: 12.5px;
            }

            .remember {
                display: flex;
                align-items: center;
                gap: 7px;
                color: #5A6472;
            }

            .forgot {
                color: #E86A2C;
                text-decoration: none;
                font-weight: 600;
            }

            .btn-login {
                width: 100%;
                padding: 13px;
                border: none;
                color: #fff;
                background: linear-gradient(120deg, #E86A2C, #D2571F);
                border-radius: 9px;
                font-size: 14.5px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 10px 24px rgba(232,106,44,0.3);
            }

                .btn-login:hover {
                    opacity: 0.94;
                }

            .divider {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 22px 0;
                color: #B0B7C0;
                font-size: 11.5px;
            }

                .divider::before, .divider::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: #E7E9EC;
                }

            .info-cards {
                display: flex;
                gap: 14px;
                background: #F5F6F8;
                border: 1px solid #E7E9EC;
                border-radius: 12px;
                padding: 16px;
            }

            .info-card {
                flex: 1;
                display: flex;
                align-items: flex-start;
                gap: 10px;
            }

            .info-icon {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .info-icon.admin {
                    background: #FBE3D6;
                    color: #C85A22;
                }

                .info-icon.emp {
                    background: #DDE8FB;
                    color: #3B6FD1;
                }

            .info-card strong {
                font-size: 12.5px;
                display: block;
                margin-bottom: 1px;
                color: #1A1F2B;
            }

            .info-card span {
                font-size: 11px;
                color: #6E7684;
                line-height: 1.4;
            }

            .error-msg {
                background: #FDECEA;
                color: #B0483F;
                padding: 11px 14px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 18px;
                border-left: 3px solid #D2483A;
            }

            .copyright {
                text-align: center;
                font-size: 11.5px;
                color: #A6ADB8;
                margin-top: 26px;
            }

            @@media (max-width: 900px) {
                body {
                    flex-direction: column;
                }

                .left-panel {
                    padding: 36px;
                }

                .feature-list {
                    display: none;
                }

                .left-footer {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <div class="left-panel">
        <div class="brand-logo">Prim<span>Xact</span></div>
        <div class="brand-sub">Workforce Portal</div>

        <div class="left-content">
            <h1>Manage your work,<span class="accent">effortlessly.</span></h1>
            <p>One place to access everything you need — from attendance and leave requests to profiles and payroll.</p>

            <div class="feature-list">
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div><strong>Employee Profiles</strong><span>View and update your profile information</span></div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M9 16l2 2 4-4"></path></svg>
                    </div>
                    <div><strong>Attendance Tracking</strong><span>Track your daily attendance in real-time</span></div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                    </div>
                    <div><strong>Leave Management</strong><span>Apply for leave and track your requests</span></div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4z"></path></svg>
                    </div>
                    <div><strong>Payroll Information</strong><span>View your salary slips and payroll details</span></div>
                </div>
            </div>
        </div>

        <div class="left-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Secure &bull; Reliable &bull; Built for every team member
        </div>
    </div>

    <div class="right-panel">
        <div class="login-box">
            <h2>Welcome back!</h2>
            <p>Sign in to continue to your dashboard</p>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">@ViewBag.Error</div>
            }

            <form method="post" action="/Account/Login">
                <div class="field">
                    <label>Username / Email</label>
                    <div class="input-wrap">
                        <span class="icon-left">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </span>
                        <input type="text" name="username" placeholder="Enter your username or email" required autofocus />
                    </div>
                </div>

                <div class="field">
                    <label>Password</label>
                    <div class="input-wrap">
                        <span class="icon-left">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </span>
                        <input type="password" name="password" id="passwordField" placeholder="Enter your password" required />
                        <button type="button" class="toggle-eye" onclick="togglePassword()">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="row-between">
                    <label class="remember">
                        <input type="checkbox" style="accent-color:#E86A2C;" /> Remember me
                    </label>
                    <a href="#" class="forgot">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="divider">OR</div>

            <div class="info-cards">
                <div class="info-card">
                    <div class="info-icon admin">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div><strong>Admins</strong><span>Sign in with your username</span></div>
                </div>
                <div class="info-card">
                    <div class="info-icon emp">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    <div><strong>Employees</strong><span>Sign in with your registered email</span></div>
                </div>
            </div>

            <div class="copyright">&copy; 2026 PrimXact. All rights reserved.</div>
        </div>
    </div>

    <script>
            function togglePassword() {
                var field = document.getElementById('passwordField');
                var icon = document.getElementById('eyeIcon');
                if (field.type === 'password') {
                    field.type = 'text';
                    icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
                } else {
                    field.type = 'password';
                    icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
                }
            }
    </script>

</body>
</html>