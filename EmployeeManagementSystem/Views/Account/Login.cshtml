@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Employee Management System</title>
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                min-height: 100vh;
                display: flex;
            }

            .left-panel {
                flex: 1.1;
                background: linear-gradient(150deg, #16202C 0%, #1F2937 55%, #16202C 100%);
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 60px;
                color: #fff;
            }

                .left-panel::before {
                    content: '';
                    position: absolute;
                    right: -120px;
                    top: -100px;
                    width: 400px;
                    height: 400px;
                    background: radial-gradient(circle, #E86A2C 0%, transparent 70%);
                    opacity: .3;
                }

                .left-panel::after {
                    content: '';
                    position: absolute;
                    left: -100px;
                    bottom: -120px;
                    width: 320px;
                    height: 320px;
                    background: radial-gradient(circle, #E86A2C 0%, transparent 70%);
                    opacity: .18;
                }

            .brand-logo {
                position: relative;
                z-index: 2;
                font-size: 20px;
                font-weight: 700;
                margin-bottom: 40px;
            }

                .brand-logo span {
                    color: #E86A2C;
                }

            .left-content {
                position: relative;
                z-index: 2;
                max-width: 420px;
            }

                .left-content h1 {
                    font-size: 32px;
                    font-weight: 700;
                    line-height: 1.25;
                    margin-bottom: 14px;
                }

                .left-content p {
                    font-size: 14px;
                    color: #B7C0CC;
                    line-height: 1.6;
                }

            .feature-list {
                margin-top: 34px;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .feature-item {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 13.5px;
                color: #D5DAE2;
            }

            .feature-dot {
                width: 26px;
                height: 26px;
                border-radius: 8px;
                background: rgba(232,106,44,0.18);
                color: #E86A2C;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                flex-shrink: 0;
            }

            .right-panel {
                flex: 0.9;
                background: #F5F6F8;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .login-box {
                width: 100%;
                max-width: 360px;
            }

                .login-box h2 {
                    font-size: 24px;
                    font-weight: 700;
                    color: #1C2321;
                    margin-bottom: 6px;
                }

                .login-box p {
                    margin: 0 0 28px;
                    color: #6E7A72;
                    font-size: 13.5px;
                }

            .field {
                margin-bottom: 17px;
            }

                .field label {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #6E7A72;
                    margin-bottom: 6px;
                }

                .field input {
                    width: 100%;
                    padding: 11px 14px;
                    border: 1px solid #E0E3E8;
                    border-radius: 9px;
                    font-size: 14px;
                    background: #fff;
                    transition: .15s;
                }

                    .field input:focus {
                        outline: none;
                        border-color: #E86A2C;
                        box-shadow: 0 0 0 3px rgba(232,106,44,0.12);
                    }

            .btn-login {
                width: 100%;
                padding: 12px;
                border: none;
                color: #fff;
                background: linear-gradient(120deg, #E86A2C, #C85A22);
                border-radius: 9px;
                font-size: 14.5px;
                font-weight: 600;
                cursor: pointer;
                margin-top: 6px;
                box-shadow: 0 8px 20px rgba(232,106,44,0.28);
            }

                .btn-login:hover {
                    opacity: 0.93;
                }

            .error-msg {
                background: #FDECEA;
                color: #B0483F;
                padding: 11px 14px;
                border-radius: 8px;
                font-size: 13px;
                margin-bottom: 18px;
                border-left: 3px solid #D2483A;
            }

            .hint {
                font-size: 11.5px;
                color: #9AA39C;
                margin-top: 22px;
                text-align: center;
                padding-top: 18px;
                border-top: 1px solid #E7E9EC;
            }

            @@media (max-width: 820px) {
                body {
                    flex-direction: column;
                }

                .left-panel {
                    padding: 36px;
                }

                .feature-list {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <div class="left-panel">
        <div class="brand-logo">Prim<span>Xact</span> HR</div>
        <div class="left-content">
            <h1>Manage your team, effortlessly.</h1>
            <p>One place for employee profiles, attendance, leave requests, and payroll — built for modern HR teams.</p>

            <div class="feature-list">
                <div class="feature-item"><div class="feature-dot">👥</div> Centralized employee records</div>
                <div class="feature-item"><div class="feature-dot">🕒</div> Daily attendance tracking</div>
                <div class="feature-item"><div class="feature-dot">💰</div> Automated payroll calculation</div>
            </div>
        </div>
    </div>

    <div class="right-panel">
        <div class="login-box">
            <h2>Welcome back</h2>
            <p>Sign in to continue to your dashboard</p>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">@ViewBag.Error</div>
            }

            <form method="post" action="/Account/Login">
                <div class="field">
                    <label>Username / Email</label>
                    <input type="text" name="username" required autofocus />
                </div>
                <div class="field">
                    <label>Password</label>
                    <input type="password" name="password" required />
                </div>
                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="hint">Admin: use your admin username · Employee: use your registered email</div>
        </div>
    </div>

</body>
</html>