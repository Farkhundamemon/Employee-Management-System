@model EmployeeManagementSystem.Models.Payroll

@{
    ViewData["Title"] = "Edit Payroll Record";
}

<div style="max-width:500px; margin:0 auto;">
    <a href="/Payroll/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Payroll</a>

    <div class="panel">
        <form method="post" action="/Payroll/Edit">
            <input type="hidden" name="payroll_id" value="@Model.payroll_id" />
            <div class="field">
                <label>Employee ID</label>
                <input type="number" name="emp_id" value="@Model.emp_id" required />
            </div>
            <div class="field">
                <label>Month</label>
                <input type="text" name="month" value="@Model.month" required />
            </div>
            <div class="field">
                <label>Basic Salary</label>
                <input type="number" step="0.01" name="basic_salary" value="@Model.basic_salary" required />
            </div>
            <div class="field">
                <label>Deduction</label>
                <input type="number" step="0.01" name="deduction" value="@Model.deduction" />
            </div>
            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn">Update Payroll Record</button>
                <a href="/Payroll/Index" class="btn outline">Cancel</a>
            </div>
        </form>
    </div>
</div>