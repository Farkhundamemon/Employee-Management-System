@model EmployeeManagementSystem.Models.Payroll

<h2>Edit Payroll Record</h2>

<form method="post" action="/Payroll/Edit">

    <input type="hidden" name="payroll_id" value="@Model.payroll_id" />

    <div class="mb-3">
        <label class="form-label">Employee ID:</label>
        <input type="number" name="emp_id" value="@Model.emp_id" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Month:</label>
        <input type="text" name="month" value="@Model.month" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Basic Salary:</label>
        <input type="number" step="0.01" name="basic_salary" value="@Model.basic_salary" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Deduction:</label>
        <input type="number" step="0.01" name="deduction" value="@Model.deduction" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Update Payroll Record</button>
    <a href="/Payroll/Index" class="btn btn-secondary">Cancel</a>

</form>