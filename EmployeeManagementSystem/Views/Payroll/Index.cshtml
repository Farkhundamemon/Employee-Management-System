@model List<EmployeeManagementSystem.Models.Payroll>

@{
    ViewData["Title"] = "Payroll";
}

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; align-items:center; gap:10px;">
            <div style="width:34px; height:34px; border-radius:9px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; font-size:16px;">💰</div>
            <div>
                <strong>Payroll Records</strong>
                <div style="color:var(--text-soft); font-size:11.5px;">@Model.Count records</div>
            </div>
        </div>
        <a href="/Payroll/Create" class="btn">+ Add Payroll Record</a>
    </div>

    @if (Model.Count == 0)
    {
        <div style="padding:30px; color:var(--text-soft); text-align:center;">No payroll records yet. Click "Add Payroll Record" to get started.</div>
    }
    else
    {
        <table>
            <tr>
                <th>Employee ID</th>
                <th>Month</th>
                <th>Basic Salary</th>
                <th>Deduction</th>
                <th>Net Salary</th>
                <th>Action</th>
            </tr>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.emp_id</td>
                    <td>
                        <span style="background:#F1F3F6; color:var(--text-soft); padding:3px 11px; border-radius:20px; font-size:11.5px; font-weight:600;">@p.month</span>
                    </td>
                    <td>Rs @p.basic_salary</td>
                    <td style="color:#D2483A;">- Rs @p.deduction</td>
                    <td><strong style="color:#2E9E6B; font-size:14px;">Rs @p.net_salary</strong></td>
                    <td>
                        <a href="/Payroll/Edit/@p.payroll_id" class="icon-btn" style="color:#5B8DEF; font-weight:600;">Edit</a>
                        <a href="/Payroll/Delete/@p.payroll_id" class="icon-btn" style="color:#D2483A; font-weight:600;" onclick="return confirm('Are you sure you want to delete this record?');">Delete</a>
                    </td>
                </tr>
            }
        </table>
    }
</div>