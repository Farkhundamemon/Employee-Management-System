@model EmployeeManagementSystem.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<div style="max-width:500px; margin:0 auto;">
    <a href="/Department/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Departments</a>

    <div class="panel">
        <form method="post" action="/Department/Edit">
            <input type="hidden" name="Dep_id" value="@Model.Dep_id" />
            <div class="field">
                <label>Department Name</label>
                <input type="text" name="Dep_name" value="@Model.Dep_name" required />
            </div>
            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn">Update Department</button>
                <a href="/Department/Index" class="btn outline">Cancel</a>
            </div>
        </form>
    </div>
</div>