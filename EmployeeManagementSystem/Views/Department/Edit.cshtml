@model EmployeeManagementSystem.Models.Department

<h2>Edit Department</h2>

<form method="post" action="/Department/Edit">

    <input type="hidden" name="Dep_id" value="@Model.Dep_id" />

    <div class="mb-3">
        <label class="form-label">Department Name:</label>
        <input type="text" name="Dep_name" value="@Model.Dep_name" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Update Department</button>
    <a href="/Department/Index" class="btn btn-secondary">Cancel</a>

</form>