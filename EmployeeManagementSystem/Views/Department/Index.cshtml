@model List<EmployeeManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; align-items:center; gap:10px;">
            <div style="width:34px; height:34px; border-radius:9px; background:#F1EAFB; display:flex; align-items:center; justify-content:center; font-size:16px;">🏢</div>
            <div>
                <strong>All Departments</strong>
                <div style="color:var(--text-soft); font-size:11.5px;">@Model.Count total</div>
            </div>
        </div>
        <a href="/Department/Create" class="btn">+ Add Department</a>
    </div>

    @if (Model.Count == 0)
    {
        <div style="padding:30px; color:var(--text-soft); text-align:center;">No departments added yet. Click "Add Department" to get started.</div>
    }
    else
    {
        <table>
            <tr>
                <th>Department</th>
                <th>Department ID</th>
                <th>Action</th>
            </tr>
            @foreach (var dept in Model)
            {
                var colors = new[] { "#5B8DEF", "#9B6FD1", "#2E9E6B", "#D9A125", "#D2483A", "#E86A2C" };
                var color = colors[dept.Dep_id % colors.Length];
                <tr>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div style="width:32px; height:32px; border-radius:9px; background:@(color)22; color:@color; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; flex-shrink:0;">
                                @(dept.Dep_name.Length > 0 ? dept.Dep_name.Substring(0, 1).ToUpper() : "D")
                            </div>
                            <strong>@dept.Dep_name</strong>
                        </div>
                    </td>
                    <td>
                        <span style="background:#F1F3F6; color:var(--text-soft); padding:3px 11px; border-radius:20px; font-size:11.5px; font-weight:600;">#@dept.Dep_id</span>
                    </td>
                    <td>
                        <a href="/Department/Edit/@dept.Dep_id" class="icon-btn" style="color:#5B8DEF; font-weight:600;">Edit</a>
                        <a href="/Department/Delete/@dept.Dep_id" class="icon-btn" style="color:#D2483A; font-weight:600;" onclick="return confirm('Are you sure you want to delete this department?');">Delete</a>
                    </td>
                </tr>
            }
        </table>
    }
</div>