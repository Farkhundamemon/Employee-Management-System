@model List<EmployeeManagementSystem.Models.Department>

<h2>Department List</h2>

<a href="/Department/Create" class="btn btn-primary mb-3">+ Add New Department</a>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Department Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Dep_id</td>
                <td>@dept.Dep_name</td>
                <td>
                    <a href="/Department/Edit/@dept.Dep_id" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/Department/Delete/@dept.Dep_id" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this department?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>