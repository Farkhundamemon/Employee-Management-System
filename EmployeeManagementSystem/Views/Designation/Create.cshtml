@model EmployeeManagementSystem.Models.Designation

@{
    ViewData["Title"] = "Add Designation";
}

<div style="max-width:500px; margin:0 auto;">
    <a href="/Designation/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Designations</a>

    <div class="panel">
        <form method="post" action="/Designation/Create">
            <div class="field">
                <label>Designation Title</label>
                <input type="text" name="title" placeholder="e.g. Software Engineer" required />
            </div>
            <div class="field">
                <label>Department</label>
                <select name="department_id" required>
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept.Dep_id">@dept.Dep_name</option>
                    }
                </select>
            </div>
            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn">Add Designation</button>
                <a href="/Designation/Index" class="btn outline">Cancel</a>
            </div>
        </form>
    </div>
</div>