@{
    ViewData["Title"] = "Dashboard";
}

<div style="background: linear-gradient(120deg, var(--navy-dark), var(--navy)); border-radius:14px; padding:26px 28px; margin-bottom:24px; color:#fff; position:relative; overflow:hidden;">
    <div style="position:absolute; right:-40px; top:-40px; width:180px; height:180px; background:radial-gradient(circle, var(--accent) 0%, transparent 70%); opacity:.35;"></div>
    <div style="position:relative; z-index:2;">
        <div style="font-size:20px; font-weight:700;">Welcome back, Admin 👋</div>
        <div style="font-size:13px; color:#B7C0CC; margin-top:4px;">Here's what's happening across your organization today</div>
    </div>
</div>

<div class="stats">
    <div class="stat-card" style="border-left:4px solid #5B8DEF;">
        <div style="font-size:20px; margin-bottom:8px;">👥</div>
        <div class="label">Total Employees</div>
        <div class="value">@ViewBag.TotalEmployees</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #2E9E6B;">
        <div style="font-size:20px; margin-bottom:8px;">🟢</div>
        <div class="label">Active Employees</div>
        <div class="value">@ViewBag.ActiveEmployees</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #D9A125;">
        <div style="font-size:20px; margin-bottom:8px;">🟡</div>
        <div class="label">Deactivated</div>
        <div class="value">@ViewBag.DeactivatedEmployees</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #D2483A;">
        <div style="font-size:20px; margin-bottom:8px;">🔴</div>
        <div class="label">Terminated</div>
        <div class="value">@ViewBag.TerminatedEmployees</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #9B6FD1;">
        <div style="font-size:20px; margin-bottom:8px;">🏢</div>
        <div class="label">Departments</div>
        <div class="value">@ViewBag.TotalDepartments</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #D9A125;">
        <div style="font-size:20px; margin-bottom:8px;">🕒</div>
        <div class="label">Present Today</div>
        <div class="value">@ViewBag.PresentToday</div>
    </div>
    <div class="stat-card" style="border-left:4px solid #D2483A;">
        <div style="font-size:20px; margin-bottom:8px;">📝</div>
        <div class="label">Pending Leaves</div>
        <div class="value">@ViewBag.PendingLeaves</div>
    </div>
</div>

<div class="panel" style="border-left:4px solid #2E9E6B; margin-bottom:24px;">
    <div style="display:flex; align-items:center; justify-content:space-between;">
        <div>
            <h2 style="margin-bottom:4px;">Total Net Payroll</h2>
            <div style="color:var(--text-soft); font-size:12.5px;">Sum of all net salaries paid</div>
        </div>
        <div style="font-size:28px; font-weight:700; color:var(--green);">Rs @ViewBag.TotalPayroll</div>
    </div>
</div>

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;">
        <div style="width:34px; height:34px; border-radius:9px; background:#EAF1FE; display:flex; align-items:center; justify-content:center; font-size:16px;">👤</div>
        <strong>Recently Added Employees</strong>
    </div>

    @if (((List<EmployeeManagementSystem.Models.Employee>)ViewBag.RecentEmployees).Count == 0)
    {
        <div style="padding:30px; color:var(--text-soft); text-align:center;">No employees added yet.</div>
    }
    else
    {
        <table>
            <tr><th>ID</th><th>Name</th><th>Designation</th><th>Salary</th></tr>
            @foreach (var emp in ViewBag.RecentEmployees)
            {
                <tr>
                    <td>@emp.emp_id</td>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div style="width:28px; height:28px; border-radius:50%; background:var(--accent-soft); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700;">
                                @(emp.emp_name.Length > 0 ? emp.emp_name.Substring(0, 1).ToUpper() : "E")
                            </div>
                            @emp.emp_name
                        </div>
                    </td>
                    <td>@emp.designation</td>
                    <td>@emp.salary</td>
                </tr>
            }
        </table>
    }
</div>