@model EmployeeManagementSystem.Models.Attendance

@{
    ViewData["Title"] = "Edit Attendance";
}

<div style="max-width:500px; margin:0 auto;">
    <a href="/Attendance/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Attendance</a>

    <div class="panel">
        <form method="post" action="/Attendance/Edit">
            <input type="hidden" name="attentence_id" value="@Model.attentence_id" />
            <div class="field">
                <label>Employee ID</label>
                <input type="number" name="emp_id" value="@Model.emp_id" required />
            </div>
            <div class="field">
                <label>Date</label>
                <input type="date" name="date" value="@Model.date.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="field">
                <label>Check In</label>
                <input type="time" name="checkIn" value="@Model.checkIn" />
            </div>
            <div class="field">
                <label>Check Out</label>
                <input type="time" name="checkOut" value="@Model.checkOut" />
            </div>
            <div class="field">
                <label>Status</label>
                <select name="status">
                    <option value="Present" selected="@(Model.status == "Present")">Present</option>
                    <option value="Absent" selected="@(Model.status == "Absent")">Absent</option>
                    <option value="Late" selected="@(Model.status == "Late")">Late</option>
                </select>
            </div>
            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn">Update Attendance</button>
                <a href="/Attendance/Index" class="btn outline">Cancel</a>
            </div>
        </form>
    </div>
</div>