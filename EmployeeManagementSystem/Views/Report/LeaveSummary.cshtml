@{
    ViewData["Title"] = "Leave Summary";
}

<a href="/Report/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Reports</a>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; max-width:700px;">
    <div class="panel" style="padding:20px; border-left:4px solid #D9A125;">
        <div style="color:var(--text-soft); font-size:12px; text-transform:uppercase;">Pending</div>
        <div style="font-size:26px; font-weight:700; margin-top:6px;">@ViewBag.Pending</div>
    </div>
    <div class="panel" style="padding:20px; border-left:4px solid #2E9E6B;">
        <div style="color:var(--text-soft); font-size:12px; text-transform:uppercase;">Approved</div>
        <div style="font-size:26px; font-weight:700; margin-top:6px;">@ViewBag.Approved</div>
    </div>
    <div class="panel" style="padding:20px; border-left:4px solid #D2483A;">
        <div style="color:var(--text-soft); font-size:12px; text-transform:uppercase;">Rejected</div>
        <div style="font-size:26px; font-weight:700; margin-top:6px;">@ViewBag.Rejected</div>
    </div>
</div>