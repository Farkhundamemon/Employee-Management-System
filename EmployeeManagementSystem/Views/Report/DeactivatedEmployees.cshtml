@{
    ViewData["Title"] = "Deactivated Employees";
}

<a href="/Report/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Reports</a>

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;">
        <div style="width:34px; height:34px; border-radius:9px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; font-size:16px;">🟡</div>
        <div>
            <strong>Deactivated Employees</strong>
            <div style="color:var(--text-soft); font-size:11.5px;">@ViewBag.Employees.Count employees</div>
        </div>
    </div>

    @if (ViewBag.Employees.Count == 0)
    {
        <div style="padding:30px; color:var(--text-soft); text-align:center;">No deactivated employees.</div>
    }
    else
    {
        <table>
            <tr><th>Employee ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Status</th></tr>
            @foreach (var emp in ViewBag.Employees)
            {
                var deptName = "Unknown";
                foreach (var d in ViewBag.Departments)
                {
                    if (d.Dep_id == emp.Dep_id) { deptName = d.Dep_name; }
                }
                <tr>
                    <td>@emp.emp_id</td>
                    <td>@emp.emp_name</td>
                    <td>@deptName</td>
                    <td>@emp.designation</td>
                    <td><span style="background:#FDF3E0; color:#B8860B; padding:3px 11px; border-radius:20px; font-size:11.5px; font-weight:600;">Deactivated</span></td>
                </tr>
            }
        </table>
    }
</div>