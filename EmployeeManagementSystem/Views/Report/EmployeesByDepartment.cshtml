@{
    ViewData["Title"] = "Employees by Department";
}

<a href="/Report/Index" class="btn outline" style="margin-bottom:16px;">&larr; Back to Reports</a>

<div class="panel" style="padding:0; overflow:hidden;">
    <div style="padding:18px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:10px;">
        <div style="width:34px; height:34px; border-radius:9px; background:#EAF1FE; display:flex; align-items:center; justify-content:center; font-size:16px;">📊</div>
        <strong>Employees by Department</strong>
    </div>
    <table>
        <tr><th>Department</th><th>Employees</th></tr>
        @foreach (var item in ViewBag.Report)
        {
            <tr>
                <td>@item.DepartmentName</td>
                <td>
                    <span style="background:#EAF1FE; color:#3B6FD1; padding:3px 12px; border-radius:20px; font-size:12px; font-weight:600;">@item.EmployeeCount</span>
                </td>
            </tr>
        }
    </table>
</div>