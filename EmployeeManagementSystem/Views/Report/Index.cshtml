@{
    ViewData["Title"] = "Reports";
}

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px;">

    <a href="/Report/EmployeesByDepartment" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #5B8DEF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#EAF1FE; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🏢</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Employees by Department</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Headcount grouped by department</div>
        </div>
    </a>

    <a href="/Report/PayrollSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #2E9E6B;">
            <div style="width:42px; height:42px; border-radius:10px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">💰</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Payroll Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Totals across all payroll records</div>
        </div>
    </a>

    <a href="/Report/LeaveSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #9B6FD1;">
            <div style="width:42px; height:42px; border-radius:10px; background:#F1EAFB; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🗓️</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Leave Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Pending, approved & rejected counts</div>
        </div>
    </a>

    <a href="/Report/AttendanceSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D9A125;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">✅</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Attendance Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Present, absent & late breakdown</div>
        </div>
    </a>

    <a href="/Report/ActiveEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #2E9E6B;">
            <div style="width:42px; height:42px; border-radius:10px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🟢</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Active Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all currently active employees</div>
        </div>
    </a>

    <a href="/Report/DeactivatedEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D9A125;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🟡</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Deactivated Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all deactivated employees</div>
        </div>
    </a>

    <a href="/Report/TerminatedEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D2483A;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDECEA; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🚫</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Terminated Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all terminated employees</div>
        </div>
    </a>

    <a href="/Report/DepartmentSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #6B5FCF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#ECEAFB; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🏛️</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Department Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Overview of all departments</div>
        </div>
    </a>

    <a href="/Report/StatusHistory" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #7B4FBF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#ECEAFB; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">📜</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Status History</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Audit log of all employee status changes</div>
        </div>
    </a>

</div>