@{
    ViewData["Title"] = "Reports";
}

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px;">

    <a href="/Report/EmployeesByDepartment" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #5B8DEF; transition:.15s;">
            <div style="width:42px; height:42px; border-radius:10px; background:#EAF1FE; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">📊</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Employees by Department</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Headcount grouped by department</div>
        </div>
    </a>

    <a href="/Report/PayrollSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #2E9E6B;">
            <div style="width:42px; height:42px; border-radius:10px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">💰</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Payroll Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Totals across all payroll records</div>
        </div>
    </a>

    <a href="/Report/LeaveSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #9B6FD1;">
            <div style="width:42px; height:42px; border-radius:10px; background:#F1EAFB; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">🗓️</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Leave Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Pending, approved & rejected counts</div>
        </div>
    </a>

    <a href="/Report/AttendanceSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D9A125;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; font-size:20px; margin-bottom:14px;">✅</div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Attendance Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Present, absent & late breakdown</div>
        </div>
    </a>

</div>