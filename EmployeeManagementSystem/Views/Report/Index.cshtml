@{
    ViewData["Title"] = "Reports";
}

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px;">

    <a href="/Report/EmployeesByDepartment" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #5B8DEF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#EAF1FE; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#5B8DEF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l8-4v18"></path><path d="M19 21V11l-6-4"></path></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Employees by Department</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Headcount grouped by department</div>
        </div>
    </a>

    <a href="/Report/PayrollSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #2E9E6B;">
            <div style="width:42px; height:42px; border-radius:10px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#2E9E6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4z"></path></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Payroll Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Totals across all payroll records</div>
        </div>
    </a>

    <a href="/Report/LeaveSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #9B6FD1;">
            <div style="width:42px; height:42px; border-radius:10px; background:#F1EAFB; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#9B6FD1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Leave Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Pending, approved & rejected counts</div>
        </div>
    </a>

    <a href="/Report/AttendanceSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D9A125;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#D9A125" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M9 16l2 2 4-4"></path></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Attendance Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Present, absent & late breakdown</div>
        </div>
    </a>

    <a href="/Report/ActiveEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #2E9E6B;">
            <div style="width:42px; height:42px; border-radius:10px; background:#E4F5EC; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#2E9E6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Active Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all currently active employees</div>
        </div>
    </a>

    <a href="/Report/DeactivatedEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D9A125;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDF3E0; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#D9A125" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Deactivated Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all deactivated employees</div>
        </div>
    </a>

    <a href="/Report/TerminatedEmployees" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #D2483A;">
            <div style="width:42px; height:42px; border-radius:10px; background:#FDECEA; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#D2483A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="17" y1="8" x2="23" y2="14"></line><line x1="23" y1="8" x2="17" y2="14"></line></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Terminated Employees</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">List of all terminated employees</div>
        </div>
    </a>

    <a href="/Report/DepartmentSummary" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #6B5FCF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#ECEAFB; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#6B5FCF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1"></rect><line x1="9" y1="7" x2="9" y2="7"></line><line x1="15" y1="7" x2="15" y2="7"></line><line x1="9" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="15" y2="12"></line><line x1="9" y1="17" x2="15" y2="17"></line></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Department Summary</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Overview of all departments</div>
        </div>
    </a>

    <a href="/Report/StatusHistory" style="text-decoration:none;">
        <div class="panel" style="padding:22px; border-left:4px solid #7B4FBF;">
            <div style="width:42px; height:42px; border-radius:10px; background:#ECEAFB; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#7B4FBF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="10"></circle></svg>
            </div>
            <div style="font-weight:700; font-size:15px; color:var(--text);">Status History</div>
            <div style="color:var(--text-soft); font-size:12.5px; margin-top:6px;">Audit log of all employee status changes</div>
        </div>
    </a>

</div>